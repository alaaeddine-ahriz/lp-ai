---
import { getImage } from "astro:assets";
import Base from "@/layouts/Base.astro";
import { site } from "@/config/site";
import type { Photos } from "@/lib/photos";
import { CompanyMap } from "@/components/CompanyMap";
import { Comparison } from "@/components/Comparison";
import { Faq, faqs } from "@/components/Faq";
import { FinalCta } from "@/components/FinalCta";
import { Footer } from "@/components/Footer";
import { Header } from "@/components/Header";
import { Hero } from "@/components/Hero";
import { MobileCta } from "@/components/MobileCta";
import { Offer } from "@/components/Offer";
import { Problems } from "@/components/Problems";
import { Team } from "@/components/Team";
import { ToolsMarquee } from "@/components/ToolsMarquee";

// Photos facultatives : déposer les fichiers dans src/assets/photos (voir le README de ce dossier).
// Chaque photo est convertie en AVIF à plusieurs tailles ; une photo absente laisse place au visuel par défaut.
const photoFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/photos/*.{jpg,jpeg,png,webp}", { eager: true });
const photos: Photos = {};
for (const [path, mod] of Object.entries(photoFiles)) {
  const name = path.split("/").pop()!.replace(/\.[^.]+$/, "");
  const widths = name === "hero" ? [640, 960, 1440, 1920, 2400] : [480, 800, 1200];
  const img = await getImage({ src: mod.default, widths, format: "avif" });
  photos[name] = { src: img.src, srcSet: img.srcSet.attribute };
}
const heroImage = photos.hero;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Base title={`${site.name} · L'IA qui rapporte aux PME`}>
  {heroImage && <link slot="head" rel="preload" as="image" imagesrcset={heroImage.srcSet} imagesizes="(min-width: 1440px) 1440px, 100vw" fetchpriority="high" />}
  <Header />
  <main>
    <Hero image={heroImage} />
    <ToolsMarquee />
    <Problems />
    <CompanyMap photos={photos} />
    <Comparison />
    <Offer />
    <Team photo={photos.team} />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
  <MobileCta />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>
